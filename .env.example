# Copy this file to .env.local and fill in the values.

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" secret key. Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tally: the form ID is the last part of your form's share link (tally.so/r/XXXXXX)
NEXT_PUBLIC_TALLY_FORM_ID=XXXXXX

# Your live site address, used for social share previews
NEXT_PUBLIC_SITE_URL=https://unsend.io

# Founders dashboard (/owner/login). Never commit real values.
# Comma-separated list of founder emails allowed to sign in
ADMIN_EMAILS=you@example.com,cofounder@example.com
# The shared dashboard password. Use a long, unique one.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Signs the login cookie. Must be 32+ random characters. Generate one with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=paste-the-output-of-openssl-rand-base64-32
